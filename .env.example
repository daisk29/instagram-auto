# Web管理画面
APP_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_BASE_URL=https://example.com/instagram

# Google Drive
# 各アカウントの設定画面で保存した値がある場合は、管理画面の値を優先します。
# 以下は既存環境との互換性と初期値として使用します。
GOOGLE_CREDENTIALS_FILE=credentials/google_oauth_credentials.json
GOOGLE_TOKEN_FILE=credentials/token.json
DRIVE_INBOX_FOLDER_ID=
DRIVE_POSTED_FOLDER_ID=

# 1つ目のInstagramアカウント（二九写真店）
PRIMARY_ACCOUNT_LABEL=二九写真店
PRIMARY_INSTAGRAM_USERNAME=29shashinten

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CAPTION_PROMPT=写真から事実として読み取れる範囲で、二九写真店のInstagram投稿文を日本語で作成してください。過度に格好つけず、仕事の内容が伝わる自然で簡潔な文章にしてください。ハッシュタグは本文末尾に5個だけ付けてください。不明な固有名詞や撮影意図を作らないでください。

# Instagram Graph API
INSTAGRAM_API_VERSION=v26.0
INSTAGRAM_IG_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# 2つ目のInstagramアカウント（Crach29）
CRACH29_ACCOUNT_LABEL=Crach29
CRACH29_INSTAGRAM_USERNAME=crach.29
CRACH29_DRIVE_INBOX_FOLDER_ID=
CRACH29_DRIVE_POSTED_FOLDER_ID=
CRACH29_INSTAGRAM_IG_USER_ID=
CRACH29_INSTAGRAM_ACCESS_TOKEN=
CRACH29_CAPTION_PROMPT=写真から事実として読み取れる範囲で、Crach29のInstagram投稿文を日本語で作成してください。過度に格好つけず、仕事や活動内容が伝わる自然で簡潔な文章にしてください。ハッシュタグは本文末尾に5個だけ付け、不明な固有名詞や撮影意図は作らないでください。

# 3つ目のInstagramアカウント（美趣）
BISYU_ACCOUNT_LABEL=美趣
BISYU_INSTAGRAM_USERNAME=bisyu_1995
BISYU_DRIVE_INBOX_FOLDER_ID=
BISYU_DRIVE_POSTED_FOLDER_ID=
BISYU_INSTAGRAM_IG_USER_ID=
BISYU_INSTAGRAM_ACCESS_TOKEN=
BISYU_CAPTION_PROMPT=写真から事実として読み取れる範囲で、美趣のInstagram投稿文を日本語で作成してください。落ち着きと親しみがあり、サービスや店内の雰囲気が自然に伝わる簡潔な文章にしてください。ハッシュタグは本文末尾に5個だけ付け、不明な固有名詞や効果を作らないでください。

# Runtime
DATABASE_PATH=data/instagram.db
MEDIA_DIR=data/media
LOG_FILE=logs/app.log
MAX_SYNC_FILES=100
APP_TIMEZONE=Asia/Tokyo
DEFAULT_SCHEDULE_HOUR=16
PUBLISH_STALE_MINUTES=10

# 管理画面からInstagramアカウントを接続するための共通Metaアプリ設定
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business使用時のみ。ユーザーアクセストークンの構成を使用。
META_LOGIN_CONFIG_ID=
# 任意。Fernet形式の鍵。未指定ならAPP_SECRET_KEYから導出（32文字以上のランダム値必須）。
# 認証情報を保存した後は暗号鍵を変更しないこと。cronとWebで同じ鍵を使う。
ACCOUNT_TOKEN_ENCRYPTION_KEY=

# 美趣専用LINE公式アカウント。空欄のままなら受け付けません。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ALLOWED_USER_IDS=
LINE_CAPTION_WINDOW_SECONDS=180
LINE_CAPTION_MAX_CHARS=2200
# 省略時はアプリ内の credentials/token.json、.line-drive-data、venv/bin/python。
# LINE_DRIVE_GOOGLE_TOKEN_PATH=/path/to/instagram-auto/credentials/token.json
# LINE_DRIVE_DATA_DIR=/path/to/instagram-auto/.line-drive-data
# LINE_DRIVE_PYTHON=/path/to/instagram-auto/venv/bin/python

# Crach29・二九写真店の共用LINE公式アカウント。美趣の値を流用しないこと。
SHARED_LINE_CHANNEL_SECRET=
SHARED_LINE_CHANNEL_ACCESS_TOKEN=
SHARED_LINE_ALLOWED_USER_IDS=
SHARED_LINE_APPROVER_IDS=
SHARED_LINE_ENABLE_POSTING=0
SHARED_LINE_CRACH29_ACCOUNT_KEY=crach29
SHARED_LINE_PHOTO29_ACCOUNT_KEY=29shashinten
# 二九写真店の管理画面で設定したDrive受信フォルダと同じID。
GOOGLE_INBOX_FOLDER_ID=

# ブラウザからの直接アップロード。既定値は1枚25MB。
DIRECT_UPLOAD_MAX_MB=25
